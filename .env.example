# cp .env.example .env
# Keys callers must send in X-Api-Key (comma separated). Empty = anyone can call the gateway.
GATEWAY_API_KEYS=change-me-with-a-long-random-value

# Only when Relay itself has API_KEYS set
# RELAY_API_KEY=

# Channels this gateway accepts (the ones your Relay workers actually deliver)
ALLOWED_CHANNELS=email
